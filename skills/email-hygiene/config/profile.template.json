{
  "$comment": "Copy to ~/.email-hygiene/profile.json and customize. NEVER commit the filled-in copy.",

  "account": {
    "email": "",
    "client_id": "",
    "authority": "https://login.microsoftonline.com/consumers"
  },

  "folders": {
    "noise": "Hygiene - Noise",
    "newsletters": "Hygiene - Newsletters",
    "review": "Hygiene - Review"
  },

  "analysis": {
    "lookback_days": 90,
    "max_messages": 5000,
    "min_messages_for_candidate": 5,
    "max_read_rate_for_candidate": 0.25,
    "scan_folders": ["inbox", "archive"]
  },

  "cleanup": {
    "enabled": true,
    "max_actions_per_run": 300,
    "mark_noise_as_read": true,
    "noise_senders": [],
    "noise_domains": [],
    "noise_subject_patterns": [],
    "protected_senders": [],
    "protected_domains": [],
    "archive_read_newsletters_after_days": 14
  },

  "rules": {
    "enabled": true,
    "prefix": "[Hygiene] ",
    "max_senders_per_rule": 40
  },

  "report": {
    "email_digest": true,
    "digest_subject": "Inbox hygiene report",
    "keep_reports": 30
  }
}
